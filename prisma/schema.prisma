// Velvetine database schema
// Meetrana date-booking integration is deliberately NOT included yet -
// Meetrana isn't deployed/running. Add a DateBooking model later once it is;
// this schema doesn't need to change to support that, it's purely additive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Core account ----------

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  displayName            String
  birthDate              DateTime // 18+ enforced at signup, see src/lib/age.ts
  gender                 Gender
  seekingGender          Gender[]
  locationCity           String?
  locationCountry        String?
  // TILLAGD 2026-09-21 på Christoffers uttryckliga önskemål: en explicit,
  // egen inställning för om man är öppen för att dejta utanför sitt eget
  // land - inte bara en passiv följd av att landsfiltret råkar vara av.
  // Default true = dagens de-facto-beteende (ingen har någonsin blivit
  // exkluderad på land, se getDiscoveryCandidates i src/lib/discovery.ts)
  // förblir oförändrat för alla befintliga användare tills de själva aktivt
  // stänger av det på /profile. Se src/lib/discovery.ts för hur det
  // faktiskt filtrerar (bara viewerns EGET flöde, aldrig vem som ser dem).
  openToInternational    Boolean   @default(true)
  bio                    String?   @db.Text
  heightCm               Int?
  occupation             String?
  bodyType               BodyType?
  hairColor              HairColor?
  relationshipIntent     RelationshipIntent?

  // Hidden matching preferences - never shown to anyone, including the
  // person being matched. Used only to rank the discovery feed so better
  // fits surface first. Soft ranking, not a hard filter - nobody gets
  // excluded from view just for not matching these.
  prefHeightMin          Int?
  prefHeightMax          Int?
  prefBodyTypes          BodyType[]
  prefHairColors         HairColor[]

  tierId                 String?
  tier                   Tier?     @relation(fields: [tierId], references: [id])
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  subscriptionStatus     SubscriptionStatus @default(NONE)

  verified               Boolean   @default(false) // identity/photo verification (selfie), not email
  emailVerified          Boolean   @default(false)
  accountStatus          AccountStatus @default(ACTIVE)
  suspendedUntil         DateTime?
  // TILLAGD 2026-09-28 - satt när accountStatus blir PAUSED, rensas
  // (null) igen när kontot återaktiveras vid inloggning. Rent
  // informativt/för admin - ingen kod filtrerar på detta datum.
  pausedAt               DateTime?
  isAdmin                Boolean   @default(false)
  warningCount           Int       @default(0)
  incognitoMode          Boolean   @default(false)
  boostedUntil           DateTime?
  equippedFrameId        String?
  equippedChatThemeId    String?
  // TILLAGD 2026-09-21 - samma mönster som ovan, för PROFILE_BACKGROUND-varor.
  equippedBackgroundId   String?
  lastViewedLikesAt      DateTime?

  // TILLAGD 2026-09-27 - poäng-saldo för digitala presenter i chatten (se
  // claude/velvetine-status.md). Presenter är INTE längre en
  // UserStoreItem-ägodel man köper en gång och skickar hur många gånger
  // som helst - varje skickad present drar av `creditCost` poäng härifrån
  // (se GiftCreditTransaction). Poäng köps i paket (GiftCreditPack) via en
  // vanlig Stripe-engångsbetalning, precis som StoreItem redan gör.
  giftCredits            Int       @default(0)

  // Explicit, separate consent for processing gender/seekingGender - this
  // can reveal sexual orientation, which GDPR Art. 9 treats as a special
  // category needing its own consent, not one bundled into general ToS
  // acceptance (this is the specific gap a 2021 Norwegian DPA ruling
  // fined Grindr over - see /villkor and /integritetspolicy).
  specialCategoryConsentAt DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  photos                 Photo[]
  promptAnswers          ProfilePromptAnswer[]
  interests              UserInterest[]
  tierVisibilityPrefs    TierVisibilityPref[]
  tierApplications       TierApplication[]
  verificationSelfie     VerificationSelfie?
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pushSubscriptions       PushSubscription[]
  storeItemPurchases      UserStoreItem[]
  safetyFlags             SafetyFlag[]
  // TILLAGD 2026-09-27 - se giftCredits ovan.
  giftCreditTransactions  GiftCreditTransaction[]

  discretionBlocksMade   DiscretionBlock[] @relation("DiscretionBlocker")
  discretionBlocksOnMe   DiscretionBlock[] @relation("DiscretionHidden")
  showcaseItems          ShowcaseItem[]

  swipesMade             Swipe[]   @relation("SwipeFrom")
  swipesReceived         Swipe[]   @relation("SwipeTo")

  matchesAsA             Match[]   @relation("MatchUserA")
  matchesAsB             Match[]   @relation("MatchUserB")

  messagesSent           Message[]

  blocksMade             Block[]   @relation("BlockerUser")
  blocksReceived         Block[]   @relation("BlockedUser")

  reportsMade            Report[]  @relation("ReporterUser")
  reportsReceived        Report[]  @relation("ReportedUser")

  @@index([tierId])
  @@index([accountStatus])
}

enum Gender {
  WOMAN
  MAN
  NONBINARY
  OTHER
}

enum RelationshipIntent {
  SERIOUS
  CASUAL
  FRIENDSHIP
  NOT_SURE
}

enum BodyType {
  SLIM
  ATHLETIC
  AVERAGE
  CURVY
  MUSCULAR
  PLUS_SIZE
}

enum HairColor {
  BLONDE
  BROWN
  BLACK
  RED
  GRAY
  OTHER
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AccountStatus {
  ACTIVE
  // TILLAGD 2026-09-28 (Christoffer: "man ska kunna välja mellan att ha
  // kvar saker eller inte" - se claude/velvetine-status.md) - ett
  // självvalt, reversibelt konto-paus, till skillnad från SUSPENDED
  // (admin-pålagt straff, tidsbegränsat). PAUSED har ingen tidsgräns och
  // hävs ALDRIG av en admin eller ett cron-jobb - bara av att personen
  // själv loggar in igen med rätt lösenord (se
  // src/app/api/auth/login/route.ts). Ingenting raderas när ett konto är
  // PAUSED - se src/app/api/account/pause/route.ts.
  PAUSED
  SUSPENDED
  BANNED
  DELETED
}

// ---------- Tiers / payment status badge ----------

model Tier {
  id                  String   @id @default(cuid())
  name                String   @unique
  nameEn              String?
  // TILLAGD 2026-09-21 - tyska/spanska UI-språk (se claude/velvetine-status.md).
  // Faller tillbaka till svenska om tomt, se pickLocalized() i localizedField.ts -
  // samma mönster som nameEn ovan, bara utökat till fler språk.
  nameDe              String?
  nameEs              String?
  level               Int      @unique // 1 (lowest) .. 5 (highest) - sort order
  priceMonthlySek      Int // price in ören (minor units), e.g. 29900 = 299.00 kr
  stripePriceId       String?  @unique
  badgeIcon           String // key into the badge icon set, not a raw URL
  badgeColor          String // hex, matches the tier's visual identity
  requiresApplication Boolean  @default(false) // true for exclusive top tier(s)

  users               User[]
  applications        TierApplication[]
  visibilityPrefs     TierVisibilityPref[]
}

enum StoreItemCategory {
  FRAME
  CHAT_THEME
  // TILLAGD 2026-09-21 - lyx-tillbehör runt 3:e byggpasset samma dag
  // (se claude/velvetine-status.md): PROFILE_BACKGROUND är en "utrustningsbar"
  // vara precis som FRAME/CHAT_THEME (en ägs, en är aktiv i taget, styrs via
  // User.equippedBackgroundId nedan).
  PROFILE_BACKGROUND
  // ÄNDRAD 2026-09-27 (se claude/velvetine-status.md): DIGITAL_GIFT ägs INTE
  // längre via UserStoreItem/Stripe - Christoffer var uttrycklig om att en
  // present inte ska vara en engångsköpt, sen-för-alltid-återanvändbar sak.
  // Den är nu ett rent katalogobjekt (namn/emoji/poängkostnad, se
  // creditCost nedan) - att skicka den i chatten drar poäng från
  // User.giftCredits varje gång, se GiftCreditTransaction.
  DIGITAL_GIFT
}

// One-time-purchase cosmetics ("flex" items) - separate from the
// recurring tier subscription. A person can own several; which one is
// actually shown is tracked via User.equippedFrameId /
// User.equippedChatThemeId below.
model StoreItem {
  id            String            @id @default(cuid())
  name          String
  nameEn        String?
  // TILLAGD 2026-09-21 - samma nameDe/nameEs-mönster som Tier ovan.
  nameDe        String?
  nameEs        String?
  description   String?
  category      StoreItemCategory
  priceSek      Int // ören, one-time (not recurring). Oanvänt/0 för DIGITAL_GIFT sedan 2026-09-27, se creditCost.
  stripePriceId String?           @unique // null för DIGITAL_GIFT sedan 2026-09-27 - de köps aldrig direkt, bara poängpaket gör.
  frameColor    String // hex - the frame's own color, independent of tier
  frameStyle    String // key describing the visual pattern (see FRAME_STYLES in ProfileCard)
  chatBubbleColor     String? // for CHAT_THEME items only - own message bubble color
  chatBackgroundColor String? // for CHAT_THEME items only - chat window background
  // TILLAGD 2026-09-21 - för PROFILE_BACKGROUND respektive DIGITAL_GIFT,
  // samma valfria-fält-mönster som chatBubbleColor/chatBackgroundColor ovan.
  backgroundGradient  String? // for PROFILE_BACKGROUND only - CSS gradient shown behind the whole profile card
  giftEmoji           String? // for DIGITAL_GIFT only - the symbol shown when this gift is sent in chat
  // TILLAGD 2026-09-27 - hur många poäng (User.giftCredits) det kostar att
  // skicka DEN HÄR presenten en gång i chatten. Oanvänd för övriga kategorier.
  creditCost          Int?
  active        Boolean           @default(true) // false = no longer sold, but past owners keep it
  order         Int               @default(0)

  purchases     UserStoreItem[]
  // TILLAGD 2026-09-21 - back-relation för Message.giftStoreItemId nedan.
  giftMessages  Message[]
  // TILLAGD 2026-09-27 - back-relation för GiftCreditTransaction.giftStoreItemId nedan.
  giftCreditTransactions GiftCreditTransaction[]
}

// TILLAGD 2026-09-27 - ett köpbart poängpaket (t.ex. "100 poäng för 39 kr").
// Poäng är en ren intern, icke-återbetalningsbar valuta som bara går att
// spendera på att skicka digitala presenter i chatten (se
// User.giftCredits, GiftCreditTransaction) - inget kontantvärde, går inte
// att lösa in eller överföra. Samma köpmönster som StoreItem: en vanlig
// Stripe-engångsbetalning ("payment"-läge), se
// src/app/api/store/credits/checkout/route.ts.
model GiftCreditPack {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  nameDe        String?
  nameEs        String?
  credits       Int // antal poäng paketet ger
  priceSek      Int // ören, one-time
  stripePriceId String?  @unique
  active        Boolean  @default(true)
  order         Int      @default(0)

  transactions  GiftCreditTransaction[]
}

enum GiftCreditTransactionType {
  PURCHASE // poäng köpta via Stripe (GiftCreditPack)
  GIFT_SENT // poäng spenderade på att skicka en present i chatten
  ADMIN_ADJUSTMENT // manuell justering (t.ex. kompensation), aldrig automatisk
  // TILLAGD 2026-09-27 (andra passet samma dag, se claude/velvetine-status.md)
  // - Christoffer ville ha fler saker att spendera poäng på utöver
  // presenter, byggt medan Stripe var otillgängligt (spendera poäng
  // rör aldrig Stripe, bara att KÖPA fler poäng gör det).
  STORE_ITEM_REDEEMED // en ram/chattfärg/profilbakgrund inlöst med poäng istället för kronor - se giftStoreItemId
  BOOST_PURCHASED // en extra profil-boost köpt för poäng, se src/app/api/profile/boost/credits/route.ts
  MESSAGE_HIGHLIGHTED // ett vanligt (icke-gåvo-)meddelande "lyft"/markerat för poäng, se Message.highlighted
}

// TILLAGD 2026-09-27 - ett litet, aldrig-raderat kvitto-spår för varje
// förändring av User.giftCredits. Inte bara "trevligt att ha": det här är
// pengar-i-praktiken (poäng köps för riktiga kronor), så om en kund
// hör av sig och undrar vart poängen tog vägen måste det gå att slå upp
// exakt, rad för rad - samma tanke som Christoffers krav på att aldrig
// gissa på pengar/juridik.
model GiftCreditTransaction {
  id             String                    @id @default(cuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id])
  type           GiftCreditTransactionType
  amount         Int // positivt för PURCHASE/ADMIN_ADJUSTMENT (tillskott), negativt för GIFT_SENT (uttag)
  balanceAfter   Int // saldot direkt efter denna rad - gör felsökning/kundsupport möjlig utan att räkna om hela historiken
  giftCreditPackId String?
  giftCreditPack GiftCreditPack?           @relation(fields: [giftCreditPackId], references: [id])
  // ÄNDRAD 2026-09-27 (andra passet) - trots namnet inte längre bara för
  // GIFT_SENT: samma fält återanvänds för STORE_ITEM_REDEEMED (vilken
  // ram/chattfärg/bakgrund som löstes in). Döptes inte om till det mer
  // generella "storeItemId" för att undvika en onödig kolumnbyte-risk i
  // Christoffers redan levande databas - fältet betyder helt enkelt
  // "vilken StoreItem, om någon, den här raden gäller".
  giftStoreItemId String?
  giftStoreItem  StoreItem?                @relation(fields: [giftStoreItemId], references: [id])
  messageId      String?                   @unique // vilket Message denna GIFT_SENT/MESSAGE_HIGHLIGHTED-rad hörde till, om någon
  // TILLAGD 2026-09-27 - Stripe Checkout Session-id för PURCHASE-rader,
  // unikt så att samma webhook-händelse aldrig kan krediteras två gånger
  // (Stripe garanterar inte "exactly once"-leverans, se webhook/route.ts).
  stripeCheckoutSessionId String?          @unique
  createdAt      DateTime                  @default(now())

  @@index([userId])
}

model UserStoreItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  storeItemId String
  storeItem   StoreItem @relation(fields: [storeItemId], references: [id])
  purchasedAt DateTime  @default(now())

  @@unique([userId, storeItemId])
}

// Vetting for tiers where requiresApplication = true.
// A user can still subscribe at a lower tier while an application is pending.
model TierApplication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tierId      String
  tier        Tier     @relation(fields: [tierId], references: [id])
  status      ApplicationStatus @default(PENDING)
  note        String?  @db.Text // applicant's own note, shown to reviewer
  reviewedAt  DateTime?
  reviewedBy  String? // admin user id, not a FK to keep admin actions simple
  createdAt   DateTime @default(now())

  @@unique([userId, tierId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Per-tier visibility toggle in a user's own discovery feed.
// Absence of a row for a given tier defaults to "visible" (opt-out model),
// see src/lib/discoveryFeed.ts for the exact default-handling.
model TierVisibilityPref {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  tierId   String
  tier     Tier    @relation(fields: [tierId], references: [id])
  visible  Boolean @default(true)

  @@unique([userId, tierId])
}

// ---------- Profile content ----------

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Prompt {
  id       String  @id @default(cuid())
  question String
  questionEn String?
  // TILLAGD 2026-09-21 - samma questionDe/questionEs-mönster som ovan.
  questionDe String?
  questionEs String?
  category String // e.g. "Om dig", "Livsstil", "Vad du söker"
  active   Boolean @default(true)

  answers  ProfilePromptAnswer[]
}

model ProfilePromptAnswer {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id])
  answer   String @db.Text
  order    Int    @default(0)

  @@unique([userId, promptId])
}

model Interest {
  id    String @id @default(cuid())
  name  String @unique
  users UserInterest[]
}

model UserInterest {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
}

// Text-only for now, deliberately - a photo per item is an obvious next
// step but needs the same photo storage decision as profile photos
// (Vercel Blob or similar), not yet connected. Nothing here needs to
// change when that's added - a photoUrl column slots in later.
model ShowcaseItem {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  category    ShowcaseCategory
  name        String
  description String?          @db.Text
  photoUrl    String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([userId])
}

enum ShowcaseCategory {
  CAR
  BOAT
  PLANE
  PROPERTY
  PET
  OTHER
}

// ---------- Safety / verification ----------

model VerificationSelfie {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  selfieUrl   String
  matchScore  Float?
  status      VerificationStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

// One row per issued reset link. tokenHash is a sha256 of the raw token
// sent by email - only the hash lives in the DB, same principle as not
// storing plaintext passwords.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Deliberately DB-backed rather than an in-memory counter - Vercel's
// serverless functions don't share memory between instances, so an
// in-memory limiter would silently do nothing in production despite
// working fine in local dev with a single process.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// A persistent record whenever automated moderation flags suspected
// CSAM, so it's never lost in a server log that scrolls away. The
// account is suspended immediately when this is created (see
// src/lib/imageModeration.ts) - review and any external reporting
// (NCMEC CyberTipline, once registered as an ESP) is a manual step from
// here, not something the code does on its own.
model SafetyFlag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  context   String // e.g. "profile_photo", "showcase_photo", "chat_image", "verification_selfie"
  imageUrl  String // kept for review purposes even though the account is suspended
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([userId])
}

// Hide my profile from a specific person (discretion mode), independent of Block.
model DiscretionBlock {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation("DiscretionBlocker", fields: [userId], references: [id])
  hiddenFromId   String
  hiddenFrom     User   @relation("DiscretionHidden", fields: [hiddenFromId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([userId, hiddenFromId])
}

// ---------- Matching ----------

model Swipe {
  id          String        @id @default(cuid())
  fromUserId  String
  fromUser    User          @relation("SwipeFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User          @relation("SwipeTo", fields: [toUserId], references: [id])
  direction   SwipeDirection
  createdAt   DateTime      @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

enum SwipeDirection {
  LIKE
  PASS
}

model Match {
  id         String      @id @default(cuid())
  userAId    String
  userA      User        @relation("MatchUserA", fields: [userAId], references: [id])
  userBId    String
  userB      User        @relation("MatchUserB", fields: [userBId], references: [id])
  status     MatchStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())

  // Null means "never opened this thread" - distinct from "opened it a
  // while ago", since a brand-new match with zero messages should still
  // show as needing attention until actually viewed once.
  lastReadByA DateTime?
  lastReadByB DateTime?

  messages   Message[]

  @@unique([userAId, userBId])
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String?  @db.Text
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  // TILLAGD 2026-09-21 - digitala presenter (se claude/velvetine-status.md).
  // Valfritt precis som imageUrl - ett meddelande är antingen text, bild
  // eller en present, aldrig flera samtidigt (UI:t skickar bara ett fält).
  // ÄNDRAD 2026-09-27: att sätta detta fält förutsätter INTE längre ägande
  // (UserStoreItem) - det drar istället poäng från User.giftCredits, se
  // GiftCreditTransaction och src/app/api/matches/[matchId]/messages/route.ts.
  giftStoreItemId String?
  giftStoreItem   StoreItem? @relation(fields: [giftStoreItemId], references: [id])
  // TILLAGD 2026-09-27 (andra passet, se claude/velvetine-status.md) - ett
  // vanligt text-/bildmeddelande kan "lyftas"/markeras för poäng (se
  // MESSAGE_HIGHLIGHTED i GiftCreditTransaction). Gäller ALDRIG samtidigt
  // som en gåva (giftStoreItemId) - en gåva är redan visuellt utmärkande,
  // se messages/route.ts där giftStoreItemId tvingar highlighted till false.
  highlighted     Boolean    @default(false)

  @@index([matchId])
}

// ---------- Safety actions ----------

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blocker    User     @relation("BlockerUser", fields: [blockerId], references: [id])
  blockedId  String
  blocked    User     @relation("BlockedUser", fields: [blockedId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("ReporterUser", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User         @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason         ReportReason
  details        String?      @db.Text
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  // Filled in automatically by src/lib/aiModeration.ts when OPENAI_API_KEY
  // is configured. Null means "not assessed yet" (no key set, or the AI
  // call failed) - admin can still resolve the report manually either way.
  aiSeverity     ReportSeverity?
  aiSummary      String?         @db.Text
  aiReviewedAt   DateTime?
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReportReason {
  FAKE_PROFILE
  HARASSMENT
  INAPPROPRIATE_CONTENT
  UNDERAGE_SUSPECTED
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

// One row per page view. RÄTTAD KOMMENTAR 2026-09-21 - beskrev tidigare en
// daglig hash av IP+user agent (se den nu oanvända getVisitorHash() i
// src/lib/tracking.ts) som aldrig skulle behöva cookie-samtycke. Det är
// INTE vad koden faktiskt gör: visitorHash är i praktiken värdet från en
// PERSISTENT besökar-cookie (velvetine_visitor_id, 1 år, se
// src/lib/visitorCookie.ts), satt av PageViewTracker.tsx bara efter att
// besökaren godkänt Analys-cookies (src/lib/analyticsConsent.ts) - alltså
// samtyckesgated, precis som den ska vara. Fältnamnet "visitorHash" är
// alltså historiskt/missvisande (det är inte en hash), men lämnat orört
// här eftersom en omdöpning bara är kosmetisk och inte påverkar något.
model PageView {
  id          String   @id @default(cuid())
  path        String
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
